[
  {
    "name": "CJS Minified",
    "path": "dist/cjs/*.js",
    "gzip": false,
    "brotli": false,
    "import": "{ cx }",
    "limit": "286B"
  },
  {
    "name": "CJS Gzipped",
    "path": "dist/cjs/*.js",
    "gzip": true,
    "brotli": false,
    "import": "{ cx }",
    "limit": "199B"
  },
  {
    "name": "CJS Brotlied",
    "path": "dist/cjs/*.js",
    "gzip": false,
    "brotli": true,
    "import": "{ cx }",
    "limit": "167B"
  },
  {
    "name": "ESM Minified",
    "path": "dist/esm/*.mjs",
    "gzip": false,
    "brotli": false,
    "import": "{ cx }",
    "limit": "122B"
  },
  {
    "name": "ESM Gzipped",
    "path": "dist/esm/*.mjs",
    "gzip": true,
    "brotli": false,
    "import": "{ cx }",
    "limit": "95B"
  },
  {
    "name": "ESM Brotlied",
    "path": "dist/esm/*.mjs",
    "gzip": false,
    "brotli": true,
    "import": "{ cx }",
    "limit": "79B"
  }
]

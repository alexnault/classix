{
  "name": "classix",
  "version": "1.0.0-semantic-release",
  "description": "The fastest and tiniest utility for conditionally joining classNames.",
  "main": "./dist/cjs/classix.js",
  "module": "./dist/esm/classix.mjs",
  "types": "./dist/classix.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/classix.d.mts",
        "default": "./dist/esm/classix.mjs"
      },
      "require": {
        "types": "./dist/classix.d.ts",
        "default": "./dist/cjs/classix.js"
      }
    },
    "./package.json": "./package.json"
  },
  "author": "Alex Nault",
  "keywords": [
    "class",
    "classes",
    "classname",
    "classnames",
    "clsx",
    "tailwind",
    "css"
  ],
  "license": "MIT",
  "repository": "https://github.com/alexnault/classix",
  "homepage": "https://github.com/alexnault/classix#readme",
  "scripts": {
    "bench": "node benchmark/index.mjs",
    "build": "rm -rf ./dist && rolldown --config rolldown.config.ts && tsc src/index.ts --ignoreConfig --declaration --emitDeclarationOnly --outDir dist && mv dist/index.d.ts dist/classix.d.ts && cp dist/classix.d.ts dist/classix.d.mts",
    "format": "prettier ./ --write",
    "lint": "eslint ./ --max-warnings=0",
    "size": "size-limit",
    "test": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "classix": "^2.2.22",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.16",
    "semantic-release": "^25.0.9",
    "size-limit": "^11.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
